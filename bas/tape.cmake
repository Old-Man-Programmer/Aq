file(WRITE tape.bas)
# piece of crap camke doesn't provide ARGC/ARGV of args after script
set(i 2)
while(i LESS ${CMAKE_ARGC})
  math(EXPR i ${i}+1)
  if("${CMAKE_ARGV${i}}" STREQUAL --)
    break()
  endif()
endwhile()
math(EXPR i ${i}+1)
while(i LESS ${CMAKE_ARGC})
  set(f "${CMAKE_ARGV${i}}")
  math(EXPR i ${i}+1)
  file(READ "${f}" bas)
  cmake_path(SET p ${f})
  cmake_path(GET p STEM LAST_ONLY bn)
  string(REPLACE "\nRUN\n" "\nCSAVE\"${bn}\"\n\nNEW\n" ts ${bas})
  file(APPEND tape.bas ${ts})
endwhile()
file(APPEND tape.bas
  "POKE14339,118:v=USR(0)\n")
