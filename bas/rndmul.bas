

5 ? CHR$(11)
10 J=INT(11*RND(1)+2)
20 FOR I=1 TO 12
30 GOSUB 100
40 NEXT I
50 GOTO 10
100 REM PROMPT ANSWER
110 K=I*J
120 ? "What is";I;"_times";J;"?"
130 SOUND(25,100)
140 INPUT AN
150 IF K<>AN THEN GOSUB 200
160 IF K<>AN THEN GOTO 120
170 IF K=AN THEN GOSUB 300
180 RETURN
200 REM WRONG ANSWER
210 ? "Oops. Try again!";CHR$(10)
220 SOUND(50,50)
230 RETURN
300 REM RIGHT ANSWER
310 ? "Right!";CHR$(10)
320 SOUND(50,80)
330 SOUND(80,50)
340 RETURN
RUN
